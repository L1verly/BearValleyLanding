---
import { InstagramIcon, FacebookIcon, TelegramIcon, GmailIcon } from "./Svg";
import { IconButton } from "./IconButton.tsx";
---

<footer
  class="flex max-xl:flex-col justify-around items-center text-white py-10 gap-6"
  style="background-color: var(--color-accent);"
>
  <div class="font-semibold text-xl font-serif">
    Bear Valley Bible Institute Україна
  </div>
  <div class="flex flex-col text-center">
    <span>Телефонуйте: +380631284647</span>
    <span>м. Біла Церква, вул. Партизанська 23</span>
  </div>
  <div class="flex gap-5">
    <IconButton client:visible>
      <InstagramIcon />
    </IconButton>
    <IconButton client:visible>
      <FacebookIcon />
    </IconButton>
    <IconButton client:visible>
      <TelegramIcon />
    </IconButton>
    <IconButton client:visible>
      <GmailIcon />
    </IconButton>
  </div>
</footer>
