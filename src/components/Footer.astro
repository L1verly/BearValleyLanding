---
import { InstagramIcon, FacebookIcon, TelegramIcon, GmailIcon } from "./Svg";
import { IconButton } from "./IconButton.tsx";
---

<footer
  class="flex justify-around items-center h-[8.5rem] text-white"
  style="background-color: var(--color-accent);"
>
  <div class="font-semibold text-xl">Bear Valley Bible Institute Україна</div>
  <div class="flex flex-col">
    <span>Телефонуйте: +380631284647</span>
    <span>м. Біла Церква, вул. Партизанська 23</span>
  </div>
  <div class="flex gap-5">
    <IconButton client:visible>
      <InstagramIcon />
    </IconButton>
    <IconButton client:visible>
      <FacebookIcon />
    </IconButton>
    <IconButton client:visible>
      <TelegramIcon />
    </IconButton>
    <IconButton client:visible>
      <GmailIcon />
    </IconButton>
  </div>
</footer>
