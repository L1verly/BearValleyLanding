---
import { TeamMemberCard } from "./TeamMemberCard";
import TerryHarmon from "../assets/teamMembers/TerryHarmon.png";
import KostyantynKisilenko from "../assets/teamMembers/KostyantynKisilenko.png";
import OleksandrRadkevych from "../assets/teamMembers/OleksandrRadkevych.jpg";
import DmitroHaliuk from "../assets/teamMembers/DmitroHaliuk.png";
import VolodimirPaziy from "../assets/teamMembers/VolodimirPaziy.png";
import OlegFofanov from "../assets/teamMembers/OlegFofanov.png";
import DenisSopelnyk from "../assets/teamMembers/DenisSopelnyk.png";
import PrimaryButton from "./Buttons/PrimaryButton";

const cards = [
  {
    image: TerryHarmon,
    name: "Тері Хармон",
    title: "Викладач",
    description:
      "Магістр теологічних наук Lorem ipsum dolor sit amet consectetur adipisicing elit. Magnam voluptate quas, voluptatibus excepturi ullam minus? Esse et, assumenda laboriosam omnis, atque non aut eum, sit soluta officiis necessitatibus. Nisi, ex.",
  },
  {
    image: KostyantynKisilenko,
    name: "Костянтин Кисиленко",
    title: "Перекладач",
    description: "Магістр теологічних наук",
  },
  {
    image: OleksandrRadkevych,
    name: "Олександр Радкевич",
    title: "Технічний Адміністратор",
    description: "teacher",
  },
  {
    image: DmitroHaliuk,
    name: "Дмитро Галюк",
    title: "Teacher",
    description: "Магістр теологічних наук",
  },
  {
    image: VolodimirPaziy,
    name: "Володимир Пазій",
    title: "Teacher",
    description: "teacher",
  },
  {
    image: OlegFofanov,
    name: "Олег Фофанов",
    title: "Teacher",
    description: "teacher",
  },
  {
    image: DenisSopelnyk,
    name: "Денис Сопельник",
    title: "Teacher",
    description: "teacher",
  },
