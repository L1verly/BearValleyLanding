---
import { TeamMemberCard } from "./TeamMemberCard";
import TerryHarmon from "../assets/teamMembers/TerryHarmon.jpg";
import KostyantynKisilenko from "../assets/teamMembers/KostyantynKisilenko.png";
import OleksandrRadkevych from "../assets/teamMembers/OleksandrRadkevych.jpg";
import DmitroHaliuk from "../assets/teamMembers/DmitroHaliuk.jpg";
import VolodimirPaziy from "../assets/teamMembers/VolodimirPaziy.jpg";
import OlegFofanov from "../assets/teamMembers/OlegFofanov.png";
import DenisSopelnik from "../assets/teamMembers/DenisSopelnik.jpg";
import PrimaryButton from "./Buttons/PrimaryButton";
import Image from "astro/components/Image.astro";

const cards = [
  {
    image: OlegFofanov,
    name: "Олег Фофанов",
    title: "Викладач",
    description: [
      "Бакалавр біблійних наук (2017-2019 рр.) | Біблійний інститут Bear Valley Україна",
      "Служив проповідником Церкви Христової м. Констянтинівка, Донецька область (2019-2022 рр.)",
      "Засновник та проповідник Церкви Христової м. Ужгород (2022 р.-наш час)",
    ],
  },
  {
    image: VolodimirPaziy,
    name: "Володимир Пазій",
    title: "Викладач",
    description: [
      "Бакалавр і магістр біблійних наук (1999-2005 рр.) | Біблійний інститут Bear Valley Україна",
      "Інженер-металург (1991-1997 рр.) | Донбаська державна машинобудівна академія",
      "Викладач біблійного інституту Bear Valley Україна з 2003 року",
      "Християнин з 1993 року",
      "Проповідник Церкви Христової м. Краматорськ, Донецька область",
    ],
  },
  {
    image: OleksandrRadkevych,
    name: "Олександр Радкевич",
    title: "Технічний Адміністратор",
    description: [
      "Бакалавр біблійних наук (2021-2023 рр.) | Біблійний інститут Bear Valley Україна",
      "Викладач та технічний адміністратор біблійного інституту Bear Valley Україна",
      "Проповідник Церкви Божої м. Чернівці з 2023 року",
    ],
  },
  {
    image: DmitroHaliuk,
    name: "Дмитро Галюк",
    title: "Викладач",
    description: [
      "Закінчив повний курс в Київській Школі Проповідників (1997-2000 рр.)",
      "Викладач біблійного інституту Bear Valley Україна з 2016 року",
      "Християнин з 1996 року",
      "Проповідник Церкви Христової м. Чернівці з 2000 року",
    ],
  },
  {
    image: TerryHarmon,
    name: "Тері Хармон",
    title: "Координатор Українського філіалу Bear Valley",
    description: [
      "Бакалавр і магістр біблійних наук (1991-1994 рр., 2003-2005 рр.) | Біблійний інститут Bear Valley",
      "Координатор Українського філіалу Bear Valley (2001 р.-наш час)",
      "Місіонер | Австрія (1985 р.), Польща (1991 р.), Росія (1995-1998 рр.), Україна (2002-2010 рр.) [Директор Біблійного інституту Bear Valley Україна]",
      "Проповідник Церкви Христової м. Чернівці з 2000 року м. Flagler (2010-2013 рр.) та м. Rapid City (2015 р.-наш час)",
      "Старійшина Церкви Христової м. Rapid City (2023 р.-наш час)",
    ],
  },

  {
    image: DenisSopelnik,
    name: "Денис Сопельник",
    title: "Директор інституту Bear Valley в Україні",
    description: [
      "Бакалавр і магістр біблійних наук (2000-2008 рр.) | Біблійний інститут Bear Valley",
      "Магістр з викладання всесвітньої історії та історії України (2000-2005 рр.) | Краматорський економіко-гуманітарний інститут",
      "Викладач біблійного інституту Bear Valley Україна з 2006 року",
      "Директор біблійного інституту Bear Valley Україна з 2010 року",
    ],
  },
  {
    image: KostyantynKisilenko,
    name: "Костянтин Кисиленко",
    title: "Перекладач",
    description: [
      "Перекладач біблійного інституту Bear Valley Україна з 2016 року",
      "Проповідник Церкви Христової м. Біла Церква з 2002 року",
    ],
  },
];
---

<section
  class="flex flex-col gap-15 w-full py-15 max-md:py-20 justify-center items-center select-none scroll-mt-16"
  id="team"
>
  <span class="text-5xl font-bold font-serif text-center">Наша команда</span>
  <div
    class="flex flex-wrap justify-center gap-20 2xl:max-w-[90rem] lg:max-w-7xl md:max-w-5xl px-5"
  >
    {
      cards.map((card, i) => (
        <div>
          <TeamMemberCard key={i} {...card} client:load client:only="react">
            <Image
              slot="imageAstro"
              src={card.image}
              alt={card.name}
              class="object-cover object-top h-70"
            />
          </TeamMemberCard>
        </div>
      ))
    }
  </div>
  <PrimaryButton
    title="Зв'язок з адміністрацією"
    href="https://t.me/teacher_BVB"
  />
</section>
