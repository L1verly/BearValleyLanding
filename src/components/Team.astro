---
import { TeamMemberCard } from "./TeamMemberCard";
import TerryHarmon from "../assets/teamMembers/TerryHarmon.png";
import KostyantynKisilenko from "../assets/teamMembers/KostyantynKisilenko.png";
import OleksandrRadkevych from "../assets/teamMembers/OleksandrRadkevych.jpg";
import DmitroHaliuk from "../assets/teamMembers/DmitroHaliuk.png";
import VolodimirPaziy from "../assets/teamMembers/VolodimirPaziy.jpg";
import OlegFofanov from "../assets/teamMembers/OlegFofanov.png";
import DenisSopelnyk from "../assets/teamMembers/DenisSopelnyk.png";
import PrimaryButton from "./Buttons/PrimaryButton";
import Image from "astro/components/Image.astro";
const cards = [
  {
    image: OlegFofanov,
    name: "Олег Фофанов",
    title: "Викладач",
    description:
      "Бакалавр біблійних наук (2017-2019 роки навчання) / Біблійний інститут Bear Valley Україна. Служив проповідником Церкви Христової у м.Констянтинівка Донецька область 2019-2022 рр. Засновник та проповідник церкви Христової у м.Ужгород 2022-Наш час. Викладач біблійного інституту Bear Valley Україна",
  },
  {
    image: VolodimirPaziy,
    name: "Володимир Пазій",
    title: "Викладач",
    description:
      "Магістр біблійних наук (2003-2005 роки навчання) та бакалавр біблійних наук (1999-2002 роки навчання) / Бібілійний інститут Bear Valley Україна. Проповідник Церкви Христової у м.Краматорськ, Донецька область. Член церкви Божої з 1993 року. Викладач біблійного інституту Bear Valley Україна з 2003 року. Інженер-металлург, випускник Донбаської державної машинобудівельної академії (1991-1997 роки навчання)",
  },

  {
    image: OleksandrRadkevych,
    name: "Олександр Радкевич",
    title: "Технічний Адміністратор",
    description:
      "Олександр Радкевич - бакалавр біблійних наук (2021-2023 роки навчання) / Біблійний інститут Bear Valley Україна. Помічник проповідника церкви Божої м.Чернівці  Викладач та технічний адміністратор біблійного інституту Bear Valley Україна",
  },
  {
    image: DmitroHaliuk,
    name: "Дмитро Галюк",
    title: "Викладач",
    description:
      "Християнин з 1996 року, закінчив повний курс в Київській Школі Проповідників (1997-2000), несе служіння проповідника в Церкві Христовій у м.Чернівці, викладач в Біблійному інституті Bear Valley Україна.",
  },
  {
    image: TerryHarmon,
    name: "Тері Хармон",
    title: "Координатор Українського філіалу Bear Valley",
    description: "Куратор Біблійного інституту Bear Valley в Україні",
  },

  {
    image: DenisSopelnyk,
    name: "Денис Сопельник",
    title: "Директор інституту Bear Valley в Україні",
    description:
      "Бакалавр і магістр біблійних наук Інституту Bear Valley, магістр з викладання всесвітньої історії та історії України",
  },
  {
    image: KostyantynKisilenko,
    name: "Костянтин Кисиленко",
    title: "Перекладач",
    description:
      "Перекладач, проповідник Церкви Христової у м.Біла Церква з 2002 року",
  },
];
---

<section
  class="flex flex-col gap-15 w-full py-15 max-md:py-20 justify-center items-center select-none"
  id="team"
>
  <span class="text-5xl font-bold font-serif text-center">Наша команда</span>
  <div
    class="flex flex-wrap justify-center gap-20 2xl:max-w-[90rem] lg:max-w-7xl md:max-w-5xl px-5"
  >
    {
      cards.map((card, i) => (
        <div>
          <TeamMemberCard key={i} {...card}>
            <Image
              slot="imageAstro"
              src={card.image}
              alt={card.name}
              class="object-cover object-top h-64"
            />
          </TeamMemberCard>
        </div>
      ))
    }
  </div>
  <PrimaryButton
    title="Зв'язок з адміністрацією"
    href="https://t.me/teacher_BVB"
  />
</section>
