---

<section class="flex flex-col gap-20 w-full pt-20 justify-center items-center">
  <span class="text-5xl font-bold font-serif">Наша команда</span>
  <div
    class="flex flex-wrap justify-center gap-20 2xl:max-w-[90rem] lg:max-w-7xl md:max-w-5xl"
  >
    {
      cards.map((card, i) => (
        <div class="justify-center">
          <TeamMemberCard key={i} {...card} />
        </div>
      ))
    }
    <!-- <div class="md:col-start-2">
      <TeamMemberCard key={cards.length - 1} {...lastCard} />
    </div> -->
  </div>
  <PrimaryButton title="Дізнатися більше" href="https://t.me/teacher_BVB" />
  <hr class="h-px my-8 border-0 bg-black" />
</section>
