---
import { TeamMemberCard } from "./TeamMemberCard";
import TerryHarmon from "../assets/teamMembers/TerryHarmon.png";
import KostyantynKisilenko from "../assets/teamMembers/KostyantynKisilenko.png";
import OleksandrRadkevych from "../assets/teamMembers/OleksandrRadkevych.jpg";
import DmitroHaliuk from "../assets/teamMembers/DmitroHaliuk.png";
import VolodimirPaziy from "../assets/teamMembers/VolodimirPaziy.jpg";
import OlegFofanov from "../assets/teamMembers/OlegFofanov.png";
import DenisSopelnyk from "../assets/teamMembers/DenisSopelnyk.png";
import PrimaryButton from "./Buttons/PrimaryButton";
import Image from "astro/components/Image.astro";
const cards = [
  {
    image: OlegFofanov,
    name: "Олег Фофанов",
    title: "Викладач",
    description: [
      "Бакалавр біблійних наук (2017-2019 рр.) | Біблійний інститут Bear Valley Україна",
      "Служив проповідником Церкви Христової у м. Констянтинівка, Донецька область (2019-2022 рр.)",
      "Засновник та проповідник церкви Христової у м. Ужгород (2022 р. - Наш час)",
    ],
  },
  {
    image: VolodimirPaziy,
    name: "Володимир Пазій",
    title: "Викладач",
    description: [
      "Магістр біблійних наук (2003-2005 рр.) | Бібілійний інститут Bear Valley Україна",
      "Бакалавр біблійних наук (1999-2002 рр.) | Бібілійний інститут Bear Valley Україна",
      "Викладач біблійного інституту Bear Valley Україна з 2003 року",
      "Проповідник Церкви Христової у м. Краматорськ, Донецька область",
      "Християнин з 1993 року",
    ],
  },
  {
    image: OleksandrRadkevych,
    name: "Олександр Радкевич",
    title: "Технічний Адміністратор",
    description: [
      "Олександр Радкевич - бакалавр біблійних наук (2021-2023 рр.) | Біблійний інститут Bear Valley Україна",
      "Проповідник церкви Божої у м. Чернівці",
      "Викладач та технічний адміністратор біблійного інституту Bear Valley Україна",
    ],
  },
  {
    image: DmitroHaliuk,
    name: "Дмитро Галюк",
    title: "Викладач",
    description: [
      "Закінчив повний курс в Київській Школі Проповідників (1997-2000 рр.)",
      "Несе служіння проповідника в Церкві Христовій у м. Чернівці з 2000 року",
      "Викладач біблійного інституту Bear Valley Україна з 2016 року",
      "Християнин з 1996 року",
    ],
  },
  {
    image: TerryHarmon,
    name: "Тері Хармон",
    title: "Координатор Українського філіалу Bear Valley",
    description: ["Куратор Біблійного інституту Bear Valley в Україні"],
  },

  {
    image: DenisSopelnyk,
    name: "Денис Сопельник",
    title: "Директор інституту Bear Valley в Україні",
    description: [
      "Бакалавр і магістр біблійних наук Інституту Bear Valley",
      "Магістр з викладання всесвітньої історії та історії України",
    ],
  },
  {
    image: KostyantynKisilenko,
    name: "Костянтин Кисиленко",
    title: "Перекладач",
    description: ["Проповідник Церкви Христової у м. Біла Церква з 2002 року"],
  },
];
---

<section
  class="flex flex-col gap-15 w-full py-15 max-md:py-20 justify-center items-center select-none scroll-mt-16"
  id="team"
>
  <span class="text-5xl font-bold font-serif text-center">Наша команда</span>
  <div
    class="flex flex-wrap justify-center gap-20 2xl:max-w-[90rem] lg:max-w-7xl md:max-w-5xl px-5"
  >
    {
      cards.map((card, i) => (
        <div>
          <TeamMemberCard key={i} {...card}>
            <Image
              slot="imageAstro"
              src={card.image}
              alt={card.name}
              class="object-cover object-top h-64"
            />
          </TeamMemberCard>
        </div>
      ))
    }
  </div>
  <PrimaryButton
    title="Зв'язок з адміністрацією"
    href="https://t.me/teacher_BVB"
  />
</section>
