---
import PrimaryButton from './PrimaryButton.tsx'
import SecondaryButton from './SecondaryButton.tsx'
---

<section class="flex items-center justify-center font-serif mt-20">
    <div class="flex flex-row xl:max-w-6xl lg:max-w-4xl md:max-w-3xl gap-6">
        <div class="flex flex-1 flex-col font-bold xl:text-6xl lg:text-5xl md:text-4xl items-start gap-10">
            <div class="flex flex-col tracking-tight">
                <span>Ми готуємо</span>
                <span>Проповідників</span>
                <span>Євангелістів</span>
                <span>Місіонерів</span>
                <span>Молодіжних</span>
                <span>служителів</span>
            </div>
            <div class="flex flex-row justify-center gap-4">
                <PrimaryButton title="Дізнатися більше"/>
                <SecondaryButton title="Подати заявку"/>
            </div>
        </div>
        <div class="flex flex-1 lg:text-xl md:text-lg items-center justify-center tracking-wider leading-relaxed">
            В Bear Valley ми працюємо над виконанням доручення 2 Тимофія 2:2 - довірити зразок здорового навчання Євангелії вірним людям, 
            які потім, у свою чергу, будуть підготовлені навчати інших.
        </div>
    </div>
</section>