---
// /src/components/News.astro
import NewsSlider from "./NewsSlider.js";
import G_1 from "../assets/news/G_1.jpg";
import Zaochne from "../assets/news/zaochne.png";
import Schedule from "../assets/news/Schedule.jpg";
import Starts_now from "../assets/news/Starts_now.jpg";
import type { SliderProps } from "../types/types.ts";
import "slick-carousel/slick/slick.css";
import "slick-carousel/slick/slick-theme.css";

const newsArray: SliderProps = [
  {
    image: G_1,
    title: "Випуск 2025 року",
    description:
      "24 травня 2025 - двоє наших студентів, нині випускники Максим та Вадим отримали ступінь бакалавра Біблійних наук. Вітаємо братів, нехай Господь благословить їх у служінні, бажаємо їм терпіння та довіри Господу",
  },
  {
    image: Starts_now,
    title: "Початок навчального 2025 року!",
    description: [
      "Слава Господу, Який дозволив розпочати навчання у вересні цього року. В цьому році семеро братів та сестер у Христі вирішили присвятити себе вивченню Святого Письма 🙏. Також ми маємо троє студентів заочної форми навчання.",
      "Отже загалом десять людей одночасно зростають духовно разом з командою Bear Valley",
    ],
  },
  {
    image: Schedule,
    title: "Розклад на 1-й семестр 2025-го навчального року",
    description:
      "В цьому семестрі студенти отримують базові знання з різних біблійних наук необхідні для подальшого навчання. Візьмемо до прикладу герменевтику (наука та мистецтво тлумачення Біблії), що є дисципліною, до основ якої студенти будуть звертатись постійно, для того щоб правильно тлумачити слово Боже! Після коротких канікул у жовтні-листопаді студенти почнуть вивчати Біблійні книги",
  },
  {
    image: Zaochne,
    title: "Заочне навчання",
    description:
      "Ми раді повідомити що в цьому році Bear Valley відкриває заочне відділення вивчення Біблії. Ви можете долучитись у якості студента, і у зручний для вас час вивчати Слово Боже! За подробицями звертайтесь до адміністрації",
  },
];
---

<section class="flex justify-center min-[985px]:py-20 scroll-mt-20" id="news">
  <NewsSlider client:load client:only="react" news={newsArray} />
</section>
