---
// /src/components/News.astro
import NewsSlider from "./NewsSlider.js";
import G_1 from "../assets/news/G_1.jpg";
import G_2 from "../assets/news/G_2.jpg";
import Graduation from "../assets/news/Graduation.jpg";
import Schedule from "../assets/news/Schedule.jpg";
import Starts_now from "../assets/news/Starts_now.jpg";
import type { SliderProps } from "../types/types.ts";
import "slick-carousel/slick/slick.css";
import "slick-carousel/slick/slick-theme.css";

const newsArray: SliderProps = [
  {
    image: Starts_now,
    title: "Початок навчального 2025 року!",
    description: "",
  },
  {
    image: G_1,
    title: "Випуск 2025 року",
    description: "",
  },
  {
    image: Schedule,
    title: "Розклад на 1-й семестр 2025-го навчального року",
    description: "",
  },
];
---

<section class="flex justify-center min-[985px]:py-20 scroll-mt-20" id="news">
  <NewsSlider client:load client:only="react" news={newsArray} />
</section>
