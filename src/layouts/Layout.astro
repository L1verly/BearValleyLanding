---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta
      name="description"
      content="Отримайте ґрунтовну біблійну освіту в біблійному інституті Bear Valley. Наша місія — готувати проповідників та лідерів для служіння, ґрунтуючись на Слові Божому"
    />
    <link rel="icon" type="image/x-icon" href="/favicon.png" />
    <title>Біблійний інститут Bear Valley Україна</title>
  </head>
  <body class="flex flex-col min-h-screen">
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow-x: hidden;
    scroll-behavior: smooth;
  }
</style>
